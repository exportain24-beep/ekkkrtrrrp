 "acts": [
  {
   "title": "Der Auslöser",
   "scenes": [
    {
     "voice": "Die Bahn veröffentlicht jeden Monat ihre Pünktlichkeit. Im September lag sie im Fernverkehr bei 52,4 Prozent. Im Oktober waren es 56,2 Prozent.",
     "sources": [
      "s2",
      "s1"
     ],
     "visual": [
      {
       "type": "bars",
       "title": "Pünktlichkeit Fernverkehr 2026",
       "unit": " %",
       "items": [
        [
         "Januar",
         52.1
        ],
        [
         "April",
         64.4
        ],
        [
         "Juni",
         52.6
        ],
        [
         "September",
         52.4
        ],
        [
         "Oktober",
         56.2
        ]
       ],
       "source": "Deutsche Bahn, betriebliche Pünktlichkeit"
      },
      {
       "type": "photo",
       "photos": [
        "p4"
       ]
      }
     ]
    },
    {
     "voice": "Die Bahn misst noch einen zweiten Wert: die Pünktlichkeit der Reisenden. Er lag im Oktober bei 62,3 Prozent. Auch das heißt: Mehr als jeder Dritte kam zu spät an.",
     "sources": [
      "s1"
     ],
     "visual": [
      {
       "type": "counter",
       "value": 62.3,
       "decimals": 1,
       "suffix": " %",
       "label": "Reisende pünktlich am Ziel, Oktober 2026",
       "source": "Deutsche Bahn"
      },
      {
       "type": "photo",
       "photos": [
        "p3"
       ],
       "headline": "Mehr als jeder Dritte zu spät"
      }
     ]
    },
    {
     "voice": "Als pünktlich gilt ein Zug, der weniger als sechs Minuten zu spät ist. Ausfälle zählen dabei nicht mit.",
     "sources": [
      "s4"
     ],
     "visual": [
      {
       "type": "photo",
       "photos": [
        "p2",
        "p4"
       ],
       "headline": "Pünktlich heißt: unter 6 Minuten",
       "highlight": [
        "6"
       ]
      }
     ]
    },
    {
     "voice": "Bahnchefin Evelyn Palla hatte für dieses Jahr mindestens sechzig Prozent versprochen. Dieses Ziel ist kaum noch zu erreichen.",
     "sources": [
      "s1"
     ],
     "visual": [
      {
       "type": "photo",
       "photos": [
        "p5"
       ],
       "layout": "framed",
       "headline": "Ziel 2026: mindestens 60 Prozent",
       "lower_third": {
        "name": "Evelyn Palla",
        "role": "Vorstandsvorsitzende der Deutschen Bahn"
       }
      }
     ]
    },
    {
     "voice": "Schon 2025 war ein Tiefpunkt. Nur 60,1 Prozent der Fernzüge kamen pünktlich an. Zehn Jahre zuvor waren es noch 74,4 Prozent.",
     "sources": [
      "s3",
      "s4"
     ],
     "visual": [
      {
       "type": "bars",
       "title": "Pünktlichkeit Fernverkehr pro Jahr",
       "unit": " %",
       "items": [
        [
         "2015",
         74.4
        ],
        [
         "2024",
         62.5
        ],
        [
         "2025",
         60.1
        ]
       ],
       "source": "Deutsche Bahn"
      }
     ]
    },
    {
     "voice": "Für die Fahrgäste hat das einen Preis. Und auch für die Bahn. 2025 zahlte sie 156,1 Millionen Euro Entschädigung für Verspätungen.",
     "sources": [
      "s18"
     ],
     "visual": [
      {
       "type": "counter",
       "value": 156.1,
       "decimals": 1,
       "suffix": " Mio. €",
       "label": "Entschädigung an Fahrgäste im Jahr 2025",
       "source": "Deutsche Bahn / APA"
      }
     ]
    },
    {
     "voice": "Die Bahn selbst nennt den Hauptgrund offen. Acht von zehn Verspätungen im Fernverkehr gehen auf die Infrastruktur zurück.",
