  {
   "title": "Warum das System scheitert",
   "scenes": [
    {
     "voice": "Eigentlich gibt es ein Sicherheitsnetz. Doch viele nutzen es nicht. Laut einer Studie des DIW Berlin beantragen rund 60 Prozent der Berechtigten keine Grundsicherung im Alter.",
     "sources": [
      "s11"
     ],
     "visual": [
      {
       "type": "counter",
       "value": 60,
       "suffix": " %",
       "label": "der Berechtigten beantragen keine Grundsicherung im Alter",
